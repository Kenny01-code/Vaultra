rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'ighiledivine77@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function validFileWrite() {
      let d = request.resource.data;
      return d.owner_id == request.auth.uid
        && d.name is string && d.name.size() > 0 && d.name.size() <= 400
        && (d.size_bytes is number || d.size_bytes is int) && d.size_bytes > 0 && d.size_bytes <= 1073741824  // 1 GB max
        && d.is_public is bool;
    }

    // ── /profiles/{userId} ────────────────────────────────────────────────────
    match /profiles/{userId} {
      // Owners can read their own profile; only the admin can view all profiles.
      allow read: if isOwner(userId) || isAdmin();

      // Owner can create and update their profile record
      allow create: if isOwner(userId);

      allow update: if isOwner(userId)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['storage_quota_bytes']))
        && (!('full_name' in request.resource.data) || request.resource.data.full_name == null || (request.resource.data.full_name is string && request.resource.data.full_name.size() <= 120))
        && (!('bio' in request.resource.data) || request.resource.data.bio == null || (request.resource.data.bio is string && request.resource.data.bio.size() <= 500));

      allow delete: if false;
    }

    // ── /files/{fileId} ───────────────────────────────────────────────────────
    match /files/{fileId} {
      // Owner can always read their own files; public files readable for share link; signed in users can view in admin
      allow read: if (isSignedIn() && (resource.data.owner_id == request.auth.uid || isAdmin()))
        || resource.data.is_public == true;

      // Only the owner can create a file record
      allow create: if isSignedIn()
        && request.resource.data.owner_id == request.auth.uid
        && validFileWrite();

      // Owner can update visibility, name, download_count
      allow update: if isSignedIn()
        && (resource.data.owner_id == request.auth.uid || isAdmin());

      // Owner can delete their own files
      allow delete: if isSignedIn()
        && (resource.data.owner_id == request.auth.uid || isAdmin());
    }

    // ── /user_roles/{docId} ───────────────────────────────────────────────────
    match /user_roles/{docId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow write: if false;
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}