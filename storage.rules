rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Block only clearly dangerous executable types — allow all media/docs
    function isSafeContentType() {
      let ct = request.resource.contentType.lower();
      return !(ct.matches('application/x-(msdownload|dosexec|shellscript|httpd-php)')
            || ct.matches('application/(x-msdos-program|java-archive|x-executable)')
            || ct.matches('text/x-(php|shellscript)')
            || ct == 'text/html'
            || ct == 'image/svg+xml');
    }

    function isUnderSizeLimit() {
      // 1 GB max
      return request.resource.size <= 1073741824;
    }

    // Primary path: vault/{userId}/{allPaths}
    match /vault/{userId}/{allPaths=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isUnderSizeLimit() && isSafeContentType();
      allow delete: if isOwner(userId);
    }

    // Alternative flat path: {userId}/{allPaths}
    match /{userId}/{allPaths=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isUnderSizeLimit() && isSafeContentType();
      allow delete: if isOwner(userId);
    }
  }
}
